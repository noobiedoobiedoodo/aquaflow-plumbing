# ============================================================================
# AQUAFLOW SAAS PLATFORM — AUTHORITATIVE ENVIRONMENT TEMPLATE
# ============================================================================
# Copy this file to .env and fill in the values before starting the application.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Database (PostgreSQL REQUIRED in Production)
# ----------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres@localhost:5432/aquaflow_db?schema=public"

# ----------------------------------------------------------------------------
# 2. Authentication (REQUIRED)
# ----------------------------------------------------------------------------
# Min 32-character random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="your-32-char-random-secret-key-here-must-be-secure"
SESSION_MAX_AGE_DAYS=30

# ----------------------------------------------------------------------------
# 3. Redis & Worker Queues (BullMQ & Rate Limiting)
# ----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
# Optional token for Upstash Redis if using HTTP REST client
REDIS_TOKEN=""

# ----------------------------------------------------------------------------
# 4. Stripe Commercialization & Standard Connect
# ----------------------------------------------------------------------------
# Stripe API Secret Key (sk_test_... for test mode, sk_live_... for production)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Webhook Signing Secret from Stripe Dashboard (whsec_...)
STRIPE_WEBHOOK_SECRET=""
# Optional Stripe Connect OAuth Client ID (ca_...) for custom connect redirects
STRIPE_CLIENT_ID=""

# ----------------------------------------------------------------------------
# 5. Email Communications (Resend)
# ----------------------------------------------------------------------------
# Resend API Key (re_...) for transactional emails & portal magic links
RESEND_API_KEY=""
EMAIL_FROM="AquaFlow <onboarding@aquaflowplumbing.com>"

# ----------------------------------------------------------------------------
# 6. SMS Communications (Twilio - Optional for Beta)
# ----------------------------------------------------------------------------
# If SMS notifications are enabled:
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ----------------------------------------------------------------------------
# 7. Persistent Object Storage (AWS S3 / Cloudflare R2)
# ----------------------------------------------------------------------------
# Leave empty in local development to use private local disk storage
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional custom endpoint for Cloudflare R2 / MinIO (e.g. https://<account>.r2.cloudflarestorage.com)
AWS_ENDPOINT=""

# ----------------------------------------------------------------------------
# 8. Observability & Monitoring (Sentry.io)
# ----------------------------------------------------------------------------
# Sentry DSN for error monitoring & performance tracking
NEXT_PUBLIC_SENTRY_DSN=""
# Sentry Auth Token for uploading source maps during production build
SENTRY_AUTH_TOKEN=""

# ----------------------------------------------------------------------------
# 9. Public Application URLs
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://aquaflow-plumbing-theta.vercel.app"
NEXT_PUBLIC_BASE_URL="https://aquaflow-plumbing-theta.vercel.app"
NEXT_PUBLIC_APP_NAME="AquaFlow Plumbing"
