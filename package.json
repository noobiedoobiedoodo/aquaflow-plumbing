    "@types/node": "^20",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-signature-canvas": "^1.0.7",
    "@types/twilio": "^3.19.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "node-fetch": "^3.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
