{
  "name": "plumber-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "worker": "npx tsx src/workers/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "load-test": "npx tsx scripts/load-test/runner.ts --allow",
    "load-test:acceptance": "npx tsx scripts/load-test/runner.ts --allow",
    "load-test:smoke": "npx tsx scripts/load-test/runner.ts --allow --smoke",
    "load-test:stress": "npx tsx scripts/load-test/runner.ts --allow --stress",
    "load-test:soak": "npx tsx scripts/load-test/runner.ts --allow --soak"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@hookform/resolvers": "^5.8.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10.70.0",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "@upstash/redis": "^1.38.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.1.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.31.0",
    "mime": "^4.1.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-hot-toast": "^2.6.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "resend": "^6.20.0",
    "sonner": "^2.0.8",
    "stripe": "^22.5.0",
    "svix": "^1.99.1",
    "tailwind-merge": "^3.6.0",
